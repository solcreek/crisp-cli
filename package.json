{
  "name": "crispctl",
  "version": "0.5.0",
  "description": "Agent-friendly CLI for Crisp support operations",
  "license": "MIT",
  "author": "linyiru",
  "type": "module",
  "bin": {
    "crispctl": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/rtm-coverage.md",
    "docs/performance.md",
    "docs/stdio.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solcreek/crisp-cli.git"
  },
  "homepage": "https://github.com/solcreek/crisp-cli#readme",
  "bugs": "https://github.com/solcreek/crisp-cli/issues",
  "keywords": [
    "crisp",
    "cli",
    "support"
  ],
  "scripts": {
    "bench": "node scripts/build.mjs && node scripts/benchmark.mjs",
    "bench:stages": "node scripts/build.mjs && node scripts/benchmark-stages.mjs",
    "bench:soak": "node scripts/build.mjs && node --expose-gc scripts/benchmark-output-soak.mjs",
    "bench:worker": "node scripts/build.mjs && node scripts/benchmark-worker.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json",
    "verify": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run coverage:rtm && npm run coverage:tooling && node scripts/package-smoke.mjs",
    "test": "npm run build && c8 node --enable-source-maps --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:rtm": "npm run build && c8 --reports-dir=coverage/rtm --include=src/rtm*.ts --lines=100 --statements=100 --functions=100 --branches=95 node --enable-source-maps --import tsx --test test/rtm*.test.ts",
    "check:rtm-reference": "npm run build && node scripts/check-rtm-reference.mjs",
    "test:live": "npm run build && node --import tsx --test test/live/*.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:tooling": "c8 --reports-dir=coverage/tooling --src=scripts --include=scripts/registry.mjs --include=scripts/installed-package-smoke.mjs --include=scripts/published-smoke.mjs --include=scripts/rtm-smoke-monitor.mjs --lines=95 --statements=95 --functions=100 --branches=90 node --test test/registry.test.mjs test/package-tooling.test.mjs test/rtm-smoke-monitor.test.mjs",
    "coverage:rtm": "c8 report --temp-directory=coverage/tmp --reports-dir=coverage/rtm --include=src/rtm*.ts --lines=100 --statements=100 --functions=100 --branches=95",
    "coverage:tooling": "c8 report --temp-directory=coverage/tmp --reports-dir=coverage/tooling --src=scripts --include=scripts/registry.mjs --include=scripts/installed-package-smoke.mjs --include=scripts/published-smoke.mjs --include=scripts/rtm-smoke-monitor.mjs --lines=95 --statements=95 --functions=100 --branches=90",
    "test:published": "node scripts/published-smoke.mjs",
    "prepublishOnly": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives"
  },
  "dependencies": {
    "commander": "15.0.0",
    "socket.io-client": "^4.8.4",
    "undici": "^6.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "c8": "^10.1.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "text-summary"
    ],
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 85
  }
}
