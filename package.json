{
  "name": "crispctl",
  "version": "0.4.0",
  "description": "Agent-friendly CLI for Crisp support operations",
  "license": "MIT",
  "author": "linyiru",
  "type": "module",
  "bin": {
    "crispctl": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/rtm-coverage.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solcreek/crisp-cli.git"
  },
  "homepage": "https://github.com/solcreek/crisp-cli#readme",
  "bugs": "https://github.com/solcreek/crisp-cli/issues",
  "keywords": [
    "crisp",
    "cli",
    "support"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:rtm && npm run test:package",
    "test": "npm run build && c8 node --enable-source-maps --import tsx --test test/*.test.ts",
    "test:rtm": "npm run build && c8 --reports-dir=coverage/rtm --include=src/rtm*.ts --lines=100 --statements=100 --functions=100 --branches=95 node --enable-source-maps --import tsx --test test/rtm*.test.ts",
    "check:rtm-reference": "npm run build && node scripts/check-rtm-reference.mjs",
    "test:live": "npm run build && node --import tsx --test test/live/*.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "commander": "15.0.0",
    "socket.io-client": "^4.8.4",
    "undici": "^6.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "c8": "^10.1.3",
    "oxfmt": "0.71.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "text-summary"
    ],
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 85
  }
}
